__pycache__/

# Keep only named final evidence sets; exploratory runs remain local.
results/*
!results/README.md
!results/test-summary.json
!results/seed42-final-comparison-*.json
!results/*-seed42-final-*/
!results/*-seed42-final-*/*
!results/*-final-functional-*/
!results/*-final-functional-*/*
!results/*-parallel-stress-*/
!results/*-parallel-stress-*/*

# GloVe case evidence, including failed trials; original HDF5 stays in data/cache.
!results/*-glove-*/
!results/*-glove-*/**

# New read-only observer and bounded cost/recall validation; retain failures.
!results/*-observe-*/
!results/*-observe-*/**
!results/*-bounded-*/
!results/*-bounded-*/**

# Preserve independent mechanism diagnostics and any failed attempts.
!results/*-mechanism-*/
!results/*-mechanism-*/**
