+/*
+ * Publish the current shared build phase from the leader backend. Parallel
+ * workers update the shared value and wake the leader instead of writing to
+ * their own backend progress slots, which are not exposed for this command.
+ */
+static void
+ReportBuildPhase(HnswBuildState * buildstate)
+{
+	uint32		phase;
+
+	if (IsParallelWorker())
+		return;
+
+	phase = pg_atomic_read_u32(&buildstate->graph->buildPhase);
+	if (phase == buildstate->reportedBuildPhase)
+		return;
+
+	pgstat_progress_update_param(PROGRESS_CREATEIDX_SUBPHASE, phase);
+	buildstate->reportedBuildPhase = phase;
+}
+
+/*
+ * Advance the shared build phase monotonically. Only the process that changes
+ * the value needs to notify the leader.
+ */
+static void
+AdvanceBuildPhase(HnswBuildState * buildstate, uint32 newPhase)
+{
+	uint32		oldPhase = pg_atomic_read_u32(&buildstate->graph->buildPhase);
+	bool		changed = false;
+
+	while (oldPhase < newPhase)
+	{
+		if (pg_atomic_compare_exchange_u32(&buildstate->graph->buildPhase,
+										   &oldPhase, newPhase))
+		{
+			changed = true;
+			break;
+		}
+	}
+
+	if (changed && IsParallelWorker() && buildstate->hnswshared != NULL)
+		ConditionVariableSignal(&buildstate->hnswshared->workersdonecv);
+
+	ReportBuildPhase(buildstate);
+}
