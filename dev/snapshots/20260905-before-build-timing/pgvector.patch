@@ -764,13 +822,14 @@ ParallelHeapScan(HnswBuildState * buildstate)
 	double		reltuples;
 
 	nparticipanttuplesorts = buildstate->hnswleader->nparticipanttuplesorts;
+	buildstate->graph = &hnswshared->graphData;
