 	InitAllocator(&buildstate.allocator, &HnswSharedMemoryAlloc, &buildstate);
 	scan = table_beginscan_parallel(heapRel,
 									ParallelTableScanFromHnswShared(hnswshared)
@@ -1090,7 +1151,7 @@ BuildGraph(HnswBuildState * buildstate)
 {
