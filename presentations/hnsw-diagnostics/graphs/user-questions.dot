digraph user_questions {
  graph [rankdir=LR, splines=ortho, nodesep=0.42, ranksep=0.64, pad=0.08, bgcolor="transparent"];
  node [shape=plain, margin=0];
  edge [color="#b8bdc3", penwidth=1.1, arrowsize=0.65];

  user [shape=circle, fixedsize=true, width=2.1, height=2.1, style=filled, fillcolor="#faf1f3", color="#b60b2d", penwidth=1.3, margin="0.18,0.18"];

  {rank=same; slow; tune; quality;}
  {rank=same; timing; compare; validate;}
  slow -> tune -> quality [style=invis];
  timing -> compare -> validate [style=invis];

  user -> slow [arrowhead=none];
  user -> tune [arrowhead=none];
  user -> quality [arrowhead=none];
  slow -> timing [color="#004f71"];
  tune -> compare [color="#004f71"];
  quality -> validate [color="#004f71"];
}
